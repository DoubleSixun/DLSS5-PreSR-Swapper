{
  "appId": "com.doublesixun.dlssnrmanager",
  "productName": "DLSS Neural Rendering Manager",
  "directories": {
    "output": "dist-standalone"
  },
  "files": [
    "standalone/**/*",
    "package.json",
    "!standalone/electron-builder.json"
  ],
  "extraMetadata": {
    "name": "dlss-neural-rendering-manager",
    "version": "0.1.0",
    "description": "Standalone manager for DLSS Neural Rendering, Pre-SR placement and OptiScaler model-pass profiles",
    "main": "standalone/main.js",
    "author": "DoubleSixun",
    "license": "MIT"
  },
  "compression": "maximum",
  "asar": true,
  "win": {
    "target": [
      "portable"
    ],
    "icon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "DLSS-Neural-Rendering-Manager-${version}-portable.${ext}"
  }
}
