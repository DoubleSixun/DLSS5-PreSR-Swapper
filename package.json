{
  "name": "dlss5-swapper",
  "version": "2.2.6",
  "description": "DLSS 5 Pre-SR Swapper - one-click Neural Rendering before Super Resolution, with standard Post-SR fallback",
  "main": "presr-main.js",
  "scripts": {
    "start": "electron .",
    "start:standalone": "electron standalone",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/collect-payload.js",
    "prebuild": "npm run icon",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb",
    "icon": "electron scripts/make-icon.js",
    "prebuild:portable": "npm run icon",
    "build:portable": "electron-builder --win portable",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1"
  },
  "author": "DoubleSixun (fork), based on DLSS5-Swapper by Rakan Alkhaldi",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.doublesixun.dlss5presrswapper",
    "productName": "DLSS 5 Pre-SR Swapper",
    "files": [
      "presr-main.js",
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "DoubleSixun",
      "icon": "app_iocn.png",
      "artifactName": "DLSS5-PreSR-Swapper-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "portable": {
      "artifactName": "DLSS5-PreSR-Swapper-${version}-portable.exe",
      "unpackDirName": "DLSS5-PreSR-Swapper"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DLSS 5 Pre-SR Swapper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true,
      "artifactName": "DLSS5-PreSR-Swapper-Setup-${version}.exe"
    }
  }
}
